# 4am short historical backtests (Massive).
MASSIVE_API_KEY=

# Alpaca supplies live SIP data/discovery and optional historical SIP backtests.
# These keys need the live SIP data entitlement. No Alpaca orders are placed.
# APCA_API_KEY_ID / APCA_API_SECRET_KEY are accepted aliases.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# DAS Trader Pro CMD API supplies locates, stock orders and fills.
# Use the reachable host running DAS (often a separate Windows machine).
# Set the intended account; das_paper does not convert a live DAS account to paper.
DAS_HOST=127.0.0.1
DAS_PORT=9800
DAS_USERNAME=
DAS_PASSWORD=
DAS_ACCOUNT=
